# ==========================================
#  Dotnet / C# build outputs
# ==========================================
[Bb]in/
[Oo]bj/
[Pp]ublish/

# Visual Studio files
.vs/
*.user
*.suo
*.userossc
*.userprefs
*.docstates

# JetBrains Rider / VS Code
.idea/
.vscode/
*.sln.iml

# Local tooling configuration
.claude/settings.local.json

# OS files
.DS_Store
Thumbs.db

# ==========================================
#  Infinity-Beyond Standalone ignores
# ==========================================

# Game installation files (manually added or linked)
/game/
/game

# Dynamic user data / configs
UserData/

# Runtime logs
*.log

# Agent build directory
*build*
*bin*
*obj*

# Deployed binaries in root folder
/*.exe
/*.dll
/*.pdb
/*.deps.json
/*.runtimeconfig.json
/runtimes/

# Keep solution files
!/Beyond/Beyond.sln

# Keep the build scripts (the broad *build* rule above would otherwise ignore build.sh)
!/build_osx.sh
!/build_win.bat
!/clean.bat
!/clean.sh

BeyondLauncher*

# Scripts
/Infinity Scripts
# ==========================================
#  Android patcher (aPatcher)
# ==========================================
# Game APKs are ~110MB and not ours to redistribute
*.apk
*.apk.idsig
# Local signing key
/aPatcher/*.keystore
# Compiled shim output
/aPatcher/shim/out/
# The patcher entry point (the broad *build*/*bin* rules above are why this
# script is called patch.bat and not build_android.bat)
!/aPatcher/patch.bat
